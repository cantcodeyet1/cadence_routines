PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Neon connection strings, from your Neon project dashboard.
# DATABASE_URL: the pooled connection (used by the running app).
# DIRECT_URL: the non-pooled connection (same host, minus "-pooler") -
#   only `prisma migrate` uses this; the pooled one doesn't support the
#   session-level advisory locks migrations need.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.neon.tech/cadence?sslmode=require
DIRECT_URL=postgresql://user:password@ep-xxxx.neon.tech/cadence?sslmode=require
